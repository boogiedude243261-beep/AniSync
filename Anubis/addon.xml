<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="anubis"
       name="Anubis Daemon"
       version="1.0.0"
       provider-name="Aidan">
    
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    
    <extension point="xbmc.python.script" library="Anubis.py">
        <provides>executable</provides>
    </extension>
    
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Fetches subtitles for playing anime via AniList, AniZip, and Subliminal.</summary>
        <description lang="en_GB">Automatically maps playing video metadata to AniList IDs and downloads matching English subtitles.</description>
        <platform>all</platform>
        <license>GPL-2.0-only</license>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
